# ── Supabase (required) ────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App URLs ───────────────────────────────────────────────────────────────────
# Same values as mobile EXPO_PUBLIC_APP_URL / EXPO_PUBLIC_ICE_BASE_URL and the
# edge WEB_BASE_URL. See root .env.example for the full cross-surface matrix.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ICE_BASE_URL=http://localhost:3000/ice

# ── Resend (email) ─────────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_key

# ── Sentry (error monitoring — optional) ───────────────────────────────────────
# When unset, the lightweight monitoring wrapper no-ops. NEXT_PUBLIC_ exposes the
# DSN to client components; SENTRY_DSN covers server route handlers.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

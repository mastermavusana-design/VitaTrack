# VitaTrack — mobile (Expo) environment
# Copy to `.env` and fill in. Only EXPO_PUBLIC_* vars are exposed to the client.

# ── Supabase ───────────────────────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key   # public by design

# ── App environment ────────────────────────────────────────────────────────────
EXPO_PUBLIC_APP_ENV=development   # development | staging | production

# ── Web companion URLs (keep in sync with the web app) ─────────────────────────
# EXPO_PUBLIC_APP_URL      == web NEXT_PUBLIC_APP_URL      == edge WEB_BASE_URL
# EXPO_PUBLIC_ICE_BASE_URL == web NEXT_PUBLIC_ICE_BASE_URL
EXPO_PUBLIC_APP_URL=http://localhost:3000
EXPO_PUBLIC_ICE_BASE_URL=http://localhost:3000/ice

# ── Sentry (error monitoring — optional) ───────────────────────────────────────
# When unset, the lightweight monitoring wrapper no-ops (no crash reports sent).
EXPO_PUBLIC_SENTRY_DSN=

# ============================================================
# VitaTrack — canonical environment matrix
# ============================================================
# Per-surface .env files live next to each app:
#   apps/mobile/.env    (EXPO_PUBLIC_* — client)
#   apps/web/.env.local (NEXT_PUBLIC_* — client; SUPABASE_SERVICE_ROLE_KEY — server)
#   supabase edge functions (SUPABASE_URL, SERVICE_ROLE, RESEND, WEB_BASE_URL)
#
# This root file documents the full matrix. The "web base URL" is the SAME
# value on every surface — only the variable name differs by convention:
#   mobile EXPO_PUBLIC_APP_URL == web NEXT_PUBLIC_APP_URL == edge WEB_BASE_URL
# Likewise the ICE base URL:
#   mobile EXPO_PUBLIC_ICE_BASE_URL == web NEXT_PUBLIC_ICE_BASE_URL
# ============================================================

# ── Supabase (get from app.supabase.com → Project Settings → API) ──────────────
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co   # mobile
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co   # web  (edge reads SUPABASE_URL)
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key                 # mobile — public by design
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key                 # web   — public by design

# Server-side / Edge Functions only — NEVER expose to any client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App environment ────────────────────────────────────────────────────────────
EXPO_PUBLIC_APP_ENV=development   # development | staging | production

# ── Web companion base URL (one value, three names) ────────────────────────────
EXPO_PUBLIC_APP_URL=http://localhost:3000   # mobile
NEXT_PUBLIC_APP_URL=http://localhost:3000   # web
WEB_BASE_URL=http://localhost:3000          # edge (send-family-invite invite links)

# ── ICE public base URL (one value, two names) ─────────────────────────────────
EXPO_PUBLIC_ICE_BASE_URL=http://localhost:3000/ice   # mobile
NEXT_PUBLIC_ICE_BASE_URL=http://localhost:3000/ice   # web

# ── Resend (transactional email: invites, data export) ─────────────────────────
RESEND_API_KEY=re_your_resend_key

# ── Sentry (optional, add in Phase 3) ──────────────────────────────────────────
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

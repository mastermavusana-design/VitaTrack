# Supabase (get from https://app.supabase.com → Project Settings → API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# For server-side / Edge Functions only (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Expo (for EAS builds)
EXPO_PUBLIC_APP_ENV=development   # development | staging | production

# Next.js web companion
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Sentry (optional, add after launch)
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
